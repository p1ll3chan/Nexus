<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/remoteScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/remote_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:targetApi="28" />

        <!-- Device identity / status header (Day 19) -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/remoteConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Connected to arch-laptop" />

                <TextView
                    android:id="@+id/remoteIdentity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textIsSelectable="true"
                    tools:text="This device: dev_0123456789abcdef\nPermissions: remote.read" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/remote_permission_explainer"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/remoteBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="?attr/colorErrorContainer"
            android:padding="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnErrorContainer"
            android:visibility="gone"
            tools:text="This phone uses the legacy shared token."
            tools:visibility="visible" />

        <!-- System status (Day 15) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/remote_status_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:targetApi="28" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/statusState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    tools:text="Updated just now" />

                <TextView
                    android:id="@+id/statusCpu"
                    style="@style/RemoteMetric"
                    tools:text="CPU  12.5% of 8 cores  ·  load 0.50 · 0.40 · 0.30" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/statusCpuBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:max="100" />

                <TextView
                    android:id="@+id/statusMemory"
                    style="@style/RemoteMetric"
                    tools:text="Memory  6.0 GB of 16.0 GB (37.5%)" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/statusMemoryBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:max="100" />

                <TextView
                    android:id="@+id/statusDisks"
                    style="@style/RemoteMetric"
                    tools:text="Disk root  250 GB of 500 GB (50%)" />

                <TextView
                    android:id="@+id/statusUptime"
                    style="@style/RemoteMetric"
                    tools:text="Uptime  1h 0m  ·  kernel 6.12" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Processes (Day 16) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityHeading="true"
            android:text="@string/remote_processes_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:targetApi="28" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/processSort"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/remote_sort_label"
                android:minHeight="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/processRefresh"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/remote_refresh" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/processOwnOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/remote_own_only" />

        <TextView
            android:id="@+id/processState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Showing 25 of 370 processes" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/processList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_process" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/processMore"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/remote_load_more"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
